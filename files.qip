# GStream's sources. Vendored files (rtl/e1, rtl/memory, rtl/sound/jt6295, rtl/debug, rtl/video/crt_adjust.sv,
# screen_rotate_two.sv) are Arcade-Vamphalf_MiSTer's, unchanged (scripts/vendor.json, PROVENANCE.md per directory);
# rtl/gs_cpumem.sv is generated from Vamphalf's vh_cpumem.sv (scripts/gen_gs_cpumem.py), rtl/video/gs_crt.sv adapted
# from its vh_crt.sv. The PLL (rtl/pll) is IP: regenerate rather than hand-edit, except the frequencies and phase.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/debug/issp_probe.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/debug/vh_trace.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/e1/e1_regram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/e1/e1_pipe.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vh_cache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gs_cpumem.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mame_keys.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gs_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/gs_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/crt_adjust.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/gs_crt.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/screen_rotate_two.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/vh_dpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/sdram_download.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/ddram_phy.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/vh_rom_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/gs_ddr_arb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/gs_et_scan.sv
set_global_assignment -name VERILOG_FILE rtl/sound/jt6295/hdl/jt6295.v
set_global_assignment -name VERILOG_FILE rtl/sound/jt6295/hdl/jt6295_acc.v
set_global_assignment -name VERILOG_FILE rtl/sound/jt6295/hdl/jt6295_adpcm.v
set_global_assignment -name VERILOG_FILE rtl/sound/jt6295/hdl/jt6295_ctrl.v
set_global_assignment -name VERILOG_FILE rtl/sound/jt6295/hdl/jt6295_rom.v
set_global_assignment -name VERILOG_FILE rtl/sound/jt6295/hdl/jt6295_serial.v
set_global_assignment -name VERILOG_FILE rtl/sound/jt6295/hdl/jt6295_sh_rst.v
set_global_assignment -name VERILOG_FILE rtl/sound/jt6295/hdl/jt6295_timing.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/oki_rom_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/sample_cache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/gs_sound.sv
set_global_assignment -name QIP_FILE rtl/pll.qip
set_global_assignment -name SDC_FILE GStream.sdc
set_global_assignment -name SYSTEMVERILOG_FILE GStream.sv
set_global_assignment -name SEARCH_PATH rtl
